<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net5.0-windows</TargetFramework>
    <RootNamespace>Firefall_DISASM_Name_Manager</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <Description>Easily manage Firefall subroutine names for disassemblers</Description>
    <Copyright>Copyright © Ascendants 2020</Copyright>
    <Company>The Melding Wars</Company>
    <Authors>Ascendants</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.5.119">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>